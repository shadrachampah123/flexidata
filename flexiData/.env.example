# PostgreSQL connection string used by the app (see src/db/index.ts).
# Create the database, then run: npx drizzle-kit push
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED. Random 32+ character string used to sign session cookies and HMAC
# tokens. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL of the deployment (used for password-reset links and
# Paystack callback URLs). On Vercel this is your https://<domain>.
# Optional for reset links, which fall back to the origin of the incoming
# request and then VERCEL_URL; set it when emails must use a custom domain
# that differs from what visitors arrived on. Never leave a localhost value
# in a production deployment.
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Wallet funding / payments
# ---------------------------------------------------------------------------
# mock     -> mobile money is simulated server-side and the wallet is credited
#             instantly (great for local dev & demos; still a real ledger).
# paystack -> real Ghanaian mobile money / card checkout. The wallet is only
#             credited after Paystack verifies the charge
#             (/api/payments/verify + /api/payments/webhook).
PAYMENTS_PROVIDER=mock
# Only needed when PAYMENTS_PROVIDER=paystack (https://dashboard.paystack.com):
PAYSTACK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Transactional email (password resets)
# ---------------------------------------------------------------------------
# Recommended: direct Resend delivery. Create an API key at
# https://resend.com/api-keys and verify your sending domain in Resend first.
# RESEND_FROM_EMAIL can include a display name, for example:
# FlexiData <support@your-verified-domain.com>
# Both values are required to send real mail in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional address that receives replies to password-reset emails.
RESEND_REPLY_TO=

# Alternative for another provider: an HTTPS relay accepting JSON POST
# { to, subject, text, html }. Used only when Resend is not fully configured.
# Leave all email settings empty in development: reset links are logged to the
# server console AND returned by the forgot-password API for local testing.
NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Data bundle fulfillment gateway
# ---------------------------------------------------------------------------
# Use DATA_API_PROVIDER=mock for local development, or point these values at
# your Ghanaian data-API aggregator / internal gateway in production.
DATA_API_PROVIDER=mock
DATA_API_BASE_URL=
DATA_API_PURCHASE_PATH=/api/v1/data/purchase
DATA_API_PURCHASE_METHOD=POST
DATA_API_BALANCE_PATH=/api/v1/float/balance
DATA_API_BALANCE_METHOD=GET

# Authentication mode: none | basic | bearer | headers
DATA_API_AUTH_TYPE=headers
DATA_API_KEY=
DATA_API_SECRET=
DATA_API_TOKEN=
DATA_API_ACCOUNT_ID=

# Optional callbacks / operational controls
DATA_API_CALLBACK_URL=http://localhost:3000/api/purchase/callback
DATA_API_WEBHOOK_SECRET=
DATA_API_TIMEOUT_MS=20000
DATA_API_SYNC_FLOAT_ON_PURCHASE=true

# Schema compatibility for the data gateway columns.
# When the database has not been migrated yet (no provider_float_balances
# table, no fulfillment_status / provider_* columns) the app degrades instead
# of failing every request. Set to false to fail loudly on a stale schema
# (useful in CI or once you know the schema is current).
DATA_API_SCHEMA_FALLBACKS=true
# How often (ms) the detected schema is re-read from the catalog. After you run
# `npx drizzle-kit push` the app resumes full provider tracking on its own.
DATA_API_SCHEMA_PROBE_MS=60000
